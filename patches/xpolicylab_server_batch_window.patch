+# LOCAL (multi-robot serving): cross-client batching. With XPL_SERVER_BATCH=1,
+# `infer_obs` CALLs from separate connections are coalesced into one
+# `model.infer_obs_batch` call instead of queueing one-by-one at _model_lock.
+# Requests that arrive while a forward is running join the next batch
+# (continuous batching); XPL_BATCH_WINDOW_MS additionally holds the first
+# request of an idle batch open that long for stragglers. XPL_BATCH_MAX caps
+# one forward (0 = no cap). Default off = upstream FIFO behavior.
+_SERVER_BATCH = os.environ.get("XPL_SERVER_BATCH", "0") == "1"
+_BATCH_WINDOW_S = float(os.environ.get("XPL_BATCH_WINDOW_MS", "0") or 0) / 1000.0
+_BATCH_MAX = int(os.environ.get("XPL_BATCH_MAX", "0") or 0)
+
 
