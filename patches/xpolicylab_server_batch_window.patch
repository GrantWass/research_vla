+    def _server_batching(self, func_name: str) -> bool:
+        return (
+            _SERVER_BATCH
+            and func_name == "infer_obs"
+            and callable(getattr(self.model, "infer_obs_batch", None))
+        )
+
+    async def _batched_infer_obs(self, obs: Any) -> tuple[Any, dict[str, Any]]:
+        future: asyncio.Future[Any] = asyncio.get_running_loop().create_future()
+        self._batch_queue.append((obs, future))
+        if self._batch_task is None or self._batch_task.done():
+            self._batch_task = asyncio.create_task(self._drain_batches())
+        return await future
+
+    async def _drain_batches(self) -> None:
+        loop = asyncio.get_running_loop()
+        while self._batch_queue:
+            deadline = loop.time() + _BATCH_WINDOW_S
+            while (
+                (_BATCH_MAX <= 0 or len(self._batch_queue) < _BATCH_MAX)
+                and loop.time() < deadline
+            ):
+                await asyncio.sleep(min(0.001, deadline - loop.time()))
+            take = len(self._batch_queue) if _BATCH_MAX <= 0 else _BATCH_MAX
+            batch = self._batch_queue[:take]
+            del self._batch_queue[:take]
+            payload = {"obs_list": [obs for obs, _ in batch], "env_idx_list": None}
+            start = time.perf_counter()
+            try:
+                results = await self._call_model_method(
+                    self.model.infer_obs_batch, payload
+                )
+            except Exception as exc:
+                for _, future in batch:
+                    if not future.done():
+                        future.set_exception(exc)
+                continue
+            info = {
+                "server_batch": len(batch),
+                "server_infer_ms": (time.perf_counter() - start) * 1000.0,
+            }
+            for (_, future), result in zip(batch, results):
+                if not future.done():
+                    future.set_result((result, info))
+
