+    def _get_action_batched(self, env_idx_list, **kwargs):
+        # One forward per PI05_MAX_BATCH robots (0/unset = whole batch at once).
+        # Order = arrival (env_idx_list order); cross-client EDF scheduling is
+        # server-side work (see scripts/serve_bench/schedulers.py), this only
+        # removes the N-sequential-forwards bottleneck.
+        max_batch = int(os.environ.get("PI05_MAX_BATCH", "0") or 0)
+        self._warmup_batches(max_batch, **kwargs)
+        fits = getattr(self, "_max_fitting_batch", 0)
+        if fits and (max_batch <= 0 or fits < max_batch):
+            max_batch = fits
+        n = len(env_idx_list)
+        step = max_batch if max_batch > 0 else n
+        action_list: list = [None] * n
+        forwards = 0
+        for start in range(0, n, step):
+            idx = list(range(start, min(start + step, n)))
+            window = _slice_stacked_obs_batch(self.observation_window, idx)
+            begin = _now_ms()
+            actions = self.policy.infer(
+                window, **_noise_kwargs(self.policy, len(idx), kwargs)
+            )["actions"]
+            _log_timing(
+                {"mode": "batched", "batch": len(idx), "infer_ms": _now_ms() - begin}
+            )
+            for pos in range(len(idx)):
+                action = actions[pos]
+                if self.robot_action_dim_info is None:
+                    action_list[idx[pos]] = action
+                else:
+                    action_list[idx[pos]] = unpack_robot_state(
+                        action,
+                        self.action_type,
+                        self.robot_action_dim_info,
+                        source_type="obs",
+                    )
+            forwards += 1
+        self._last_batch_info = {
+            "batched": True,
+            "batch_size": n,
+            "forwards": forwards,
+        }
+        if not getattr(self, "_batched_logged", False):
+            print(f"[Pi_05] batched infer active: batch_size={n} forwards={forwards}")
+            self._batched_logged = True
