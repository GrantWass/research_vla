+
+    def _warmup_batches(self, max_batch, **kwargs):
+        # JAX compiles once per new batch shape (~9-13 s each on a 4070 Ti
+        # SUPER), which stalls every waiting robot mid-episode the first time
+        # a fleet happens to ask in a new group size. PI05_WARMUP_BATCHES=
+        # "1,2,3,4" compiles those sizes up front, on the first call, by
+        # replaying the first real observation. Unset = compile lazily.
+        if getattr(self, "_warmed", False):
+            return
+        self._warmed = True
+        sizes = [
+            int(v) for v in os.environ.get("PI05_WARMUP_BATCHES", "").split(",")
+            if v.strip().isdigit() and int(v) > 0
+        ]
+        # Doubles as a VRAM probe: the first size that fails (e.g. B=8 OOMs
+        # under XLA_PYTHON_CLIENT_MEM_FRACTION=0.45 on 16 GB) caps every
+        # later forward at the largest size that fit, instead of each
+        # oversized batch failing and silently falling back to sequential.
+        for size in sorted(set(sizes)):
+            if max_batch > 0 and size > max_batch:
+                continue
+            window = _slice_stacked_obs_batch(self.observation_window, [0] * size)
+            begin = _now_ms()
+            try:
+                self.policy.infer(window, **_noise_kwargs(self.policy, size, kwargs))
+            except Exception as exc:
+                _log_timing({"mode": "warmup_failed", "batch": size, "error": str(exc)[:200]})
+                self._max_fitting_batch = max(1, size - 1)
+                print(f"[Pi_05] batch {size} does not fit; capping at {self._max_fitting_batch}")
+                break
+            _log_timing({"mode": "warmup", "batch": size, "infer_ms": _now_ms() - begin})
+
