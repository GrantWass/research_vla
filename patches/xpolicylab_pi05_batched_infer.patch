+def _slice_stacked_obs_batch(
+    obs: dict[str, Any], indices: list[int]
+) -> dict[str, Any]:
+    idx = list(indices)
+    return {
+        "state": obs["state"][idx],
+        "images": {
+            "cam_high": obs["images"]["cam_high"][idx],
+            "cam_left_wrist": obs["images"]["cam_left_wrist"][idx],
+            "cam_right_wrist": obs["images"]["cam_right_wrist"][idx],
+        },
+        "prompt": [obs["prompt"][i] for i in idx],
+    }
+
+
+def _noise_kwargs(policy, batch: int, kwargs: dict[str, Any]) -> dict[str, Any]:
+    # Serve-bench equivalence hook: PI05_NOISE_SEED=<int> gives every robot
+    # the SAME flow-matching start noise on every call, so a batched answer
+    # can be compared value-for-value against the one-robot answer for the
+    # same observation. Unset = upstream random noise.
+    seed = os.environ.get("PI05_NOISE_SEED", "")
+    if not seed or "noise" in kwargs:
+        return kwargs
+    import numpy as np
+
+    model = getattr(policy, "_model", None)
+    horizon = int(getattr(model, "action_horizon", 50))
+    dim = int(getattr(model, "action_dim", 32))
+    one = np.random.default_rng(int(seed)).standard_normal((horizon, dim))
+    noise = np.repeat(one[None].astype(np.float32), batch, axis=0)
+    return {**kwargs, "noise": noise[0] if batch == 1 else noise}
+
+
+def _now_ms() -> float:
+    import time
+
+    return time.perf_counter() * 1000.0
+
+
+def _log_timing(record: dict[str, Any]) -> None:
+    # Serve-bench hook: when PI05_TIMING_LOG is set, append one JSON line per
+    # model forward (mode/infer_ms). Unset = zero overhead, nothing written.
+    # The harness (scripts/serve_bench/report.py) summarizes the file.
+    path = os.environ.get("PI05_TIMING_LOG", "")
+    if not path:
+        return
+    try:
+        import json
+
+        with open(path, "a", encoding="utf-8") as f:
+            f.write(json.dumps(record) + "\n")
+    except Exception:
+        pass
+
