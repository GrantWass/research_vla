+import os
+
+# LOCAL (multi-robot serving): PI05_ATOMIC=1 routes observation+inference
+# through one server call (infer_obs / infer_obs_batch) instead of the
+# two-call update/get pair. The pair can interleave with another client's
+# calls on the shared server-side model state and answer from the wrong
+# observations; the single call holds one server lock for both halves.
+# Default 0 = upstream two-call behavior.
+_ATOMIC = os.environ.get("PI05_ATOMIC", "0") == "1"
+
+
+def _infer_single(model_client, obs):
+    if _ATOMIC:
+        return model_client.call(func_name="infer_obs", obs=obs)
+    model_client.call(func_name="update_obs", obs=obs)  # Update Observation
+    return model_client.call(func_name="get_action")  # Get Action according to observation chunk
+
+
+def _infer_batch(model_client, obs_list, env_idx_list):
+    if _ATOMIC:
+        return model_client.call(
+            func_name="infer_obs_batch",
+            obs={"obs_list": obs_list, "env_idx_list": env_idx_list},
+        )
+    model_client.call(func_name="update_obs_batch", obs=obs_list)
+    return model_client.call(func_name="get_action_batch", obs=env_idx_list)  # Get Action according to observation chunk
+
+
