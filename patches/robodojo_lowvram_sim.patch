diff --git a/env_cfg/sim/sim_config.yml b/env_cfg/sim/sim_config.yml
index fde7dc4..d9b7794 100644
--- a/env_cfg/sim/sim_config.yml
+++ b/env_cfg/sim/sim_config.yml
@@ -2,5 +2,28 @@ decimation: 1
 dt: 0.004
 render_interval: 10
 scene:
-  num_envs: 10
+  # LOCAL: one env per eval. Batched adapters (pi0.5 sets eval_batch: true) would
+  # otherwise spawn 10 parallel sims here: ~3x the RAM/VRAM of the single-env
+  # adapters, and an unequal comparison. Also makes the physx sizing below honest.
+  num_envs: 1
   env_spacing: 7
+# LOCAL low-VRAM render profile (16 GB GPU shared with a 3-7B policy server).
+# Denoiser stays ON: without it the cameras are visibly speckled, which is a
+# distribution shift for the policy, not just a cosmetic change.
+render:
+  rendering_mode: performance
+  antialiasing_mode: "DLAA"
+  enable_translucency: false
+  enable_reflections: false
+  enable_global_illumination: false
+  carb_settings:
+    /rtx-transient/resourcemanager/enableTextureStreaming: true
+    /rtx-transient/resourcemanager/texturestreaming/memoryBudget: 0.1
+# LOCAL: PhysX GPU buffers sized for the num_envs=1 eval above (defaults target 10).
+physx:
+  gpu_max_rigid_contact_count: 1048576
+  gpu_max_rigid_patch_count: 81920
+  gpu_found_lost_pairs_capacity: 262144
+  gpu_found_lost_aggregate_pairs_capacity: 4194304
+  gpu_total_aggregate_pairs_capacity: 262144
+  gpu_collision_stack_size: 33554432
