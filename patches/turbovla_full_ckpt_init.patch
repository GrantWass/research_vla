+    def _load_full_checkpoint(self, source: dict, path: str) -> None:
+        target = self.model.state_dict()
+        remapped = {}
+        for key, value in source.items():
+            key = self._LEGACY_NAMES.get(key, key)
+            for old, new in self._LEGACY_PREFIXES:
+                if key.startswith(old):
+                    key = new + key[len(old) :]
+                    break
+            remapped[key] = value
+        loaded = {k: v for k, v in remapped.items()
+                  if k in target and tuple(target[k].shape) == tuple(v.shape)}
+        skipped = sorted(set(remapped) - set(loaded))
+        if len(loaded) < 0.8 * len(target):
+            raise RuntimeError(
+                f"only {len(loaded)}/{len(target)} tensors matched {path}; "
+                f"check num_views / state_dim / action_dim / horizon against the ckpt "
+                f"(first mismatches: {skipped[:5]})"
+            )
+        target.update(loaded)
+        self.model.load_state_dict(target, strict=True)
+        print(
+            f"[TurboVLA] full-checkpoint init: loaded {len(loaded)}/{len(target)} tensors "
+            f"from {path}" + (f" ({len(skipped)} skipped, e.g. {skipped[:3]})" if skipped else ""),
+            flush=True,
+        )
